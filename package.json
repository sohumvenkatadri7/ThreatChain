{
  "name": "threatchain-soc",
  "version": "1.0.0",
  "description": "ThreatChain Root Startup Scripts",
  "scripts": {
    "start:blockchain": "cd threatchain-contracts && npx hardhat node",
    "start:backend": "cd threatchain-backend && .\\venv\\Scripts\\python.exe -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:frontend": "cd threatchain-frontend && npm run dev",
    "start:sniffer": ".\\threatchain-backend\\venv\\Scripts\\python.exe live_sniffer.py",
    "start-all": "concurrently -c \"cyan.bold,magenta.bold,green.bold,red.bold\" -n \"BLOCKCHAIN,BACKEND,FRONTEND,SNIFFER\" \"npm run start:blockchain\" \"npm run start:backend\" \"npm run start:frontend\" \"npm run start:sniffer\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
